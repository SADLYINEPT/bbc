  .origin-body p{ color:var(--cream-dim); line-height:1.85; font-size:15px; margin-bottom:16px; }
  .origin-body p b{ color:var(--cream); font-weight:400; border-bottom:1px solid var(--amber); }
  .graffiti-note{
    font-family:'Permanent Marker', cursive;
    color:var(--amber);
    font-size:22px;
    margin-top:24px;
    transform:rotate(-2deg);
    display:inline-block;
  }

  /* ---------- how to buy ---------- */
  .steps{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
    margin-top:20px;
  }
  .step{
    background:var(--bg);
    padding:32px 26px;
    position:relative;
  }
  .step .num{
    font-family:'DotGothic16', sans-serif;
    font-size:44px;
    color:var(--amber-dim);
    -webkit-text-stroke:1px var(--amber);
    color:transparent;
  }
  .step h3{
    font-family:'Space Mono', monospace;
    font-size:15px;
    letter-spacing:0.03em;
    text-transform:uppercase;
    margin:16px 0 10px;
    color:var(--cream);
  }
  .step p{ font-size:13.5px; color:var(--cream-dim); line-height:1.6; }

  /* ---------- tokenomics ---------- */
  .stat-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
    margin-top:20px;
  }
  .stat{
    background:var(--bg-2);
    padding:34px 24px;
    text-align:left;
  }
  .stat .val{
    font-family:'DotGothic16', sans-serif;
    font-size:34px;
    color:var(--amber);
  }
  .stat .lbl{
    font-size:12px; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--cream-dim); margin-top:8px;
  }
  .placeholder-note{
    margin-top:18px; font-size:12px; color:var(--cream-dim); opacity:0.7;
  }

  /* ---------- gallery ---------- */
  .board{
    position:relative;
    background:
      repeating-linear-gradient(0deg, rgba(255,255,255,0.02) 0px, transparent 1px, transparent 40px),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.02) 0px, transparent 1px, transparent 40px),
      var(--bg-2);
    border:1px solid var(--line);
    padding:60px 5vw;
  }
  .board-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(200px, 1fr));
    gap:28px;
    margin-top:20px;
  }
  .polaroid{
    background:#efe7d4;
    padding:10px 10px 34px;
    box-shadow:0 10px 24px rgba(0,0,0,0.5);
    transform:rotate(var(--r,0deg));
    position:relative;
  }
  .polaroid:nth-child(1){ --r:-3deg; }
  .polaroid:nth-child(2){ --r:2deg; }
  .polaroid:nth-child(3){ --r:-1.5deg; }
  .polaroid:nth-child(4){ --r:3deg; }
  .polaroid:nth-child(5){ --r:-2.5deg; }
  .polaroid:nth-child(6){ --r:1.5deg; }
  .polaroid:nth-child(7){ --r:2.5deg; }
  .polaroid:nth-child(8){ --r:-3deg; }
  .polaroid:nth-child(9){ --r:1deg; }
  .polaroid:nth-child(10){ --r:-1.5deg; }
  .polaroid:nth-child(11){ --r:2.8deg; }
  .polaroid:nth-child(12){ --r:-2.2deg; }
  .polaroid:nth-child(13){ --r:1.8deg; }
  .polaroid img{
    width:100%; aspect-ratio:1/1; object-fit:cover;
    display:block;
    filter:saturate(0.9) contrast(1.05);
  }
  .polaroid .cap{
    font-family:'Permanent Marker', cursive;
    color:#2a2016;
    font-size:14px;
    margin-top:12px;
    text-align:center;
  }
  .pin{
    position:absolute; top:-8px; left:50%; transform:translateX(-50%);
    width:14px; height:14px; border-radius:50%;
    background:var(--live);
    box-shadow:0 2px 3px rgba(0,0,0,0.5);
  }

  /* ---------- footer ---------- */
  footer{
    border-top:1px solid var(--line);
    padding:56px 6vw 40px;
    display:flex; flex-direction:column; gap:28px;
  }
  .footer-top{ display:flex; justify-content:space-between; flex-wrap:wrap; gap:24px; align-items:flex-start; }
  .footer-brand{ font-family:'DotGothic16', sans-serif; font-size:24px; }
  .footer-links{ display:flex; gap:28px; font-size:13px; }
  .footer-links a{ text-decoration:none; color:var(--cream-dim); border-bottom:1px solid transparent; }
  .footer-links a:hover{ color:var(--amber); border-color:var(--amber); }
  .disclaimer{
    font-size:11.5px; line-height:1.7; color:var(--cream-dim); opacity:0.65;
    max-width:820px;
    border-top:1px dashed var(--line);
    padding-top:22px;
  }

  @media (max-width: 900px){
    .origin{ grid-template-columns:1fr; }
    .steps, .stat-grid{ grid-template-columns:1fr 1fr; }
    .board-grid{ grid-template-columns:1fr 1fr; }
  }
  @media (max-width: 560px){
    .steps, .stat-grid, .board-grid{ grid-template-columns:1fr; }
    nav .cta-small{ display:none; }
  }

  @media (prefers-reduced-motion: reduce){
    .ticker-track{ animation:none; }
    .rec-dot{ animation:none; }
  }
</style>
</head>
